{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "slay",
  "description": "Docs for slay, the composition-guide camera for iPhone: free cinematic LUTs and how to apply them in code.",
  "colors": {
    "primary": "#19d0e8",
    "light": "#19d0e8",
    "dark": "#0e9fb3"
  },
  "favicon": "/logo/slay.svg",
  "logo": {
    "light": "/logo/slay.svg",
    "dark": "/logo/slay.svg",
