        {
          "anchor": "Blog",
          "href": "https://www.slaycamera.com/blog?utm_source=docs&utm_medium=anchor",
          "icon": "newspaper"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://www.slaycamera.com/?utm_source=docs&utm_medium=navbar"
      }
